# GraphQL UG - Microsoft Entra ID Configuration
# Copy this file to .env and fill in your values

# ===== DEMO MODE =====
# Set to "True" for development with demo user (bypasses Azure AD authentication)
# Set to "False" for production with Azure AD authentication
DEMO=True

# ===== AZURE AD CONFIGURATION =====
# Required when DEMO=False
# Get these values from Azure Portal > App registrations > Your App

# Application (client) ID
AZURE_CLIENT_ID=your-client-id-here

# Client secret (from Certificates & secrets)
AZURE_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID
AZURE_TENANT_ID=your-tenant-id-here

# Redirect URI (must match Azure AD app registration)
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

# Required Microsoft Graph API scopes (comma-separated)
AZURE_SCOPES=User.Read,User.ReadBasic.All

# ===== DATABASE CONFIGURATION =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=gql_ug
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Create demo data on startup (set to True in development)
DEMODATA=True

# ===== LOGGING =====
# Optional: Send logs to syslog server (format: host:port)
# SYSLOGHOST=localhost:514

# ===== LEGACY JWT CONFIGURATION (NOT USED WITH AZURE AD) =====
# These are kept for reference but not used when Azure AD is enabled
# JWTPUBLICKEYURL=https://...
# JWTRESOLVEUSERPATHURL=https://...
